{
  "manifest_version": 3,
  "name": "PhishDetect",
  "version": "1.0.0",
  "description": "AI-powered phishing detection for Gmail",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PhishDetect"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:8000 https://mail.google.com https://prospects-tip-expressed-cds.trycloudflare.com"
  }
}
