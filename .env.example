# === Database ===
POSTGRES_USER=phishdetect
POSTGRES_PASSWORD=phishdetect
POSTGRES_DB=phishdetect
DATABASE_URL=postgresql://phishdetect:phishdetect@localhost:5432/phishdetect

# === Redis / Queue ===
REDIS_URL=redis://localhost:6379/0

# === Scoring thresholds (0-100 scale) ===
# Invariant enforced at startup: max(weights) * 100 < HIGH_THRESHOLD
HIGH_THRESHOLD=70.0
MEDIUM_THRESHOLD=35.0

# === Signal weights (must sum = 1.0; max single weight < HIGH_THRESHOLD/100 = 0.70) ===
# 6 signals — must match app/config.py (attachment was added after the original 5).
WEIGHT_HEADER=0.20
WEIGHT_CONTENT=0.30
WEIGHT_URL=0.25
WEIGHT_QRCODE=0.08
WEIGHT_THREAT_INTEL=0.07
WEIGHT_ATTACHMENT=0.10

# === ML ===
MODEL_VERSION=v0.2.0
MODEL_PATH=ml/models

# === External probes ===
RDAP_TIMEOUT=5.0
HTTP_PROBE_TIMEOUT=8.0
MAX_REDIRECT_HOPS=5

# === Multi-tenancy (Phase 1: leave UNSET — single tenant) ===
# Keep commented so the app sees None, not "" (an empty string is a value).
# DEFAULT_TENANT_ID=

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Security ===
# Secret for any future auth middleware
SECRET_KEY=change-me-in-production
